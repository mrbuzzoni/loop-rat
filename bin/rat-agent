#!/usr/bin/env bash
# rat-agent - the one place in the harness that talks to a model.
#
#   printf 'do the thing' | rat-agent --tag act
#
# Reads a prompt on stdin, prints the model's answer on stdout, and files the
# raw response next to the receipt. Cost is added to today's ledger. If no agent
# binary is installed, or RAT_DRY_RUN=1, it returns a stub so every other part of
# the pipeline stays testable on a laptop with no API key.
#
# A transient failure - an overloaded API, a rate limit, a dropped connection -
# is waited out rather than reported as a lost night. A permanent one (bad
# credentials, a model that does not exist) is reported immediately, because
# waiting will not help and the receipt should say so while you can still act.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
. "$HERE/lib/common.sh"

TAG="agent"
while [ $# -gt 0 ]; do
  case "$1" in
    --tag) TAG="$2"; shift 2 ;;
    --help|-h) awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "$0"; exit 0 ;;
    *) rat_err "rat-agent: unknown argument $1"; exit 2 ;;
  esac
done

# Hanging on a terminal that will never send anything is not a helpful default.
if [ -t 0 ]; then
  rat_err "rat-agent reads the prompt on stdin:  printf 'do the thing' | rat-agent --tag act"
  exit 2
fi
PROMPT="$(cat)"
OUT_DIR="${RAT_RECEIPT:-$RAT_STATE_DIR/scratch}"
mkdir -p "$OUT_DIR"
RAW="$OUT_DIR/agent-$TAG.json"

AGENT_CMD="$(rat_setting agent.command claude)"
# A relative command is relative to the harness, not to wherever this shift
# happens to be standing - a worktree shift runs `act.sh` from a throwaway
# checkout, and `./my-agent` would not be there.
case "$AGENT_CMD" in
  ./*|../*) AGENT_CMD="$RAT_ROOT/${AGENT_CMD#./}" ;;
esac
MODEL_FLAG="$(rat_setting agent.model_flag --model)"
RESULT_FIELD="$(rat_setting agent.result_field result)"
COST_FIELD="$(rat_setting agent.cost_field total_cost_usd)"

read_args() {
  rat_py - "$RAT_SETTINGS" <<'PY'
import json, shlex, sys
with open(sys.argv[1]) as fh:
    settings = json.load(fh)
print(" ".join(shlex.quote(a) for a in settings.get("agent", {}).get("args", [])))
PY
}

stub() {
  rat_py - "$RAW" "$1" <<'PY'
import json, sys
path, reason = sys.argv[1], sys.argv[2]
payload = {
    "result": "[dry run] %s - no model was called. "
              "The harness ran every other phase for real." % reason,
    "total_cost_usd": 0.0,
    "num_turns": 0,
    "is_dry_run": True,
}
with open(path, "w") as fh:
    json.dump(payload, fh, indent=2)
print(payload["result"])
PY
}

# The per-shift cap stops the next call, not the one already in flight. A loop
# that asks the model twice cannot walk past its ceiling on the second question.
if [ -n "${RAT_MAX_USD:-}" ] && [ -d "$OUT_DIR" ]; then
  SPENT_THIS_SHIFT="$(rat_py "$RAT_ROOT/bin/lib/sum_cost.py" "$OUT_DIR")"
  if rat_py -c 'import sys; sys.exit(0 if float(sys.argv[1]) >= float(sys.argv[2]) else 1)' \
       "$SPENT_THIS_SHIFT" "$RAT_MAX_USD"; then
    rat_err "rat-agent: this shift has spent \$$SPENT_THIS_SHIFT of its \$$RAT_MAX_USD cap"
    printf '**The shift hit its spend cap.**\n\n$%s of $%s used before this call.\n' \
      "$SPENT_THIS_SHIFT" "$RAT_MAX_USD"
    rat_trace agent capped "spent=$SPENT_THIS_SHIFT cap=$RAT_MAX_USD tag=$TAG"
    exit 1
  fi
fi

if [ "${RAT_DRY_RUN:-0}" = "1" ]; then
  stub "RAT_DRY_RUN=1"
  exit 0
fi

if ! command -v "$AGENT_CMD" >/dev/null 2>&1; then
  rat_warn "rat-agent: '$AGENT_CMD' is not on PATH - falling back to a dry run"
  stub "'$AGENT_CMD' not installed"
  exit 0
fi

# read_args prints shell-quoted words, so eval is what makes an argument with a
# space in it survive - plain word splitting would tear it in half.
eval "ARGS=($(read_args))"

# A loop that only summarises numbers does not need the model that writes code.
# On a subscription this is the difference between a schedule you can afford to
# run every day and one you switch off after a week.
if [ -n "${RAT_MODEL:-}" ] && [ -n "$MODEL_FLAG" ]; then
  ARGS=(${ARGS[@]+"${ARGS[@]}"} "$MODEL_FLAG" "$RAT_MODEL")
fi
RETRIES="$(rat_setting agent.retries 2)"
DELAY="$(rat_setting agent.retry_delay_seconds 20)"
COST_FILE="$OUT_DIR/agent-$TAG.cost"
ATTEMPT=0
RC=0

while :; do
  ATTEMPT=$((ATTEMPT + 1))

  AGENT_RC=0
  printf '%s' "$PROMPT" | "$AGENT_CMD" ${ARGS[@]+"${ARGS[@]}"} \
    > "$RAW" 2> "$OUT_DIR/agent-$TAG.stderr" || AGENT_RC=$?

  # Held back rather than printed: only the last attempt's answer belongs in
  # output.md. A report that opens with two failures and then succeeds reads as
  # if the night went badly when it did not.
  RC=0
  rat_py "$RAT_ROOT/bin/lib/agent_result.py" "$RAW" "$COST_FILE" \
    "$RESULT_FIELD" "$COST_FIELD" > "$OUT_DIR/agent-$TAG.answer" || RC=$?

  # A failed attempt still costs money and still spends a call, so it goes in
  # the ledger either way.
  rat_budget_add "$(cat "$COST_FILE" 2>/dev/null || echo 0)" "${RAT_LOOP:-unknown}" 1

  if [ "$RC" -eq 0 ]; then
    if [ "$AGENT_RC" -ne 0 ]; then RC="$AGENT_RC"; fi
    cat "$OUT_DIR/agent-$TAG.answer"
    break
  fi

  if [ "$RC" -ne 2 ] || [ "$ATTEMPT" -gt "$RETRIES" ]; then
    [ "$RC" -eq 2 ] && RC=1
    if [ "$ATTEMPT" -gt 1 ]; then
      printf '**The shift could not reach the model, after %d attempts.**\n\n' "$ATTEMPT"
      tail -n +3 "$OUT_DIR/agent-$TAG.answer" 2>/dev/null || cat "$OUT_DIR/agent-$TAG.answer"
    else
      cat "$OUT_DIR/agent-$TAG.answer"
    fi
    break
  fi

  # Keep what the failed attempt cost and said, then wait longer each time.
  cp "$COST_FILE" "$OUT_DIR/agent-$TAG-attempt$ATTEMPT.cost" 2>/dev/null || true
  mv "$OUT_DIR/agent-$TAG.answer" "$OUT_DIR/agent-$TAG-attempt$ATTEMPT.answer" 2>/dev/null || true
  cp "$RAW" "$OUT_DIR/agent-$TAG-attempt$ATTEMPT.json" 2>/dev/null || true
  printf '0.0000\n' > "$COST_FILE"
  WAIT=$((DELAY * ATTEMPT))

  # Do not start a wait the shift cannot outlive. Being killed mid-retry loses
  # the receipt's explanation and looks like a timeout rather than an
  # overloaded API, which is the wrong thing to read in the morning.
  if [ -n "${RAT_SHIFT_DEADLINE:-}" ]; then
    LEFT=$(( RAT_SHIFT_DEADLINE - $(rat_epoch) ))
    if [ "$LEFT" -lt $((WAIT + 30)) ]; then
      rat_warn "rat-agent: ${LEFT}s left in this shift, not waiting ${WAIT}s to retry"
      rat_trace agent gave-up "tag=$TAG attempt=$ATTEMPT left=${LEFT}s"
      RC=1
      printf '**The shift could not reach the model, after %d attempt(s).**\n\n' "$ATTEMPT"
      tail -n +3 "$OUT_DIR/agent-$TAG-attempt$ATTEMPT.answer" 2>/dev/null || true
      printf '\nIt stopped retrying because only %ds of the shift were left.\n' "$LEFT"
      break
    fi
  fi

  rat_warn "rat-agent: transient failure on attempt $ATTEMPT, waiting ${WAIT}s"
  rat_trace agent retrying "tag=$TAG attempt=$ATTEMPT wait=${WAIT}s"
  sleep "$WAIT"
done

rm -f "$OUT_DIR/agent-$TAG.answer"
exit "$RC"
