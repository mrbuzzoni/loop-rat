#!/usr/bin/env bash
# rat - front door for the loop rat harness.
#
#   rat list                 what is scheduled, and whether it is paused
#   rat run <name>           run one shift now
#   rat run-due              run every loop the schedule says is due (cron uses this)
#   rat status [--json]      last verdict per loop, today's spend, halt state
#   rat receipts [n]         the last n receipts, newest first
#                            filters: --loop NAME --verdict V --since 3d --json
#   rat show [receipt]       read one receipt in full (--diff opens the patch first)
#   rat trace [n]            tail the trace log
#   rat watch [loop]         follow a running shift, phase by phase, until it ends
#   rat replay [receipt]     ask the same brief again and compare the two answers
#   rat apply <receipt>      apply the patch a shift produced, after you read it
#   rat prune [--apply]      age out old receipts (lists them first)
#   rat new <name>           scaffold a new loop from the template
#   rat add <pack|path>      install a loop someone else already ran (--list to browse)
#   rat cron                 print crontab lines for the current schedule
#   rat audit [--days N]     is the record intact, and what still needs a person
#   rat doctor               check the setup before you trust it overnight
#   rat resume               clear the halt file left by kill.sh
#   rat version              which rat this is
#
# Every command reads state/ and .claude/loops/ relative to this file, so it
# does not matter which directory you call it from.
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
. "$HERE/lib/common.sh"

RAT_VERSION="0.7.0"
SCHEDULE="$RAT_LOOPS_DIR/schedule.yml"
SCHED_PY="$RAT_ROOT/bin/lib/schedule.py"

usage() { awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "$0"; }

cmd_list() {
  printf '%-16s %-8s %-14s %-9s %-13s %s\n' LOOP EVERY WINDOW DAYS AUTONOMY STATE
  rat_py "$SCHED_PY" list "$SCHEDULE" | while IFS=$'\t' read -r name every window days state; do
    local autonomy=""
    if [ -f "$RAT_LOOPS_DIR/$name/plan.md" ]; then
      autonomy="$(rat_py "$RAT_CONF" fm-get "$RAT_LOOPS_DIR/$name/plan.md" autonomy 2>/dev/null || true)"
    fi
    [ -n "$autonomy" ] || autonomy="report-only"
    printf '%-16s %-8s %-14s %-9s %-13s %s\n' \
      "$name" "$every" "$window" "$days" "$autonomy" "$state"
  done
}

cmd_run_due() {
  local ran=0 name
  while read -r name; do
    [ -n "$name" ] || continue
    ran=1
    "$RAT_ROOT/bin/shift" "$name" "$@" || true
  done < <(rat_py "$SCHED_PY" due "$SCHEDULE" "$RAT_CHECKPOINT")
  [ "$ran" = "1" ] || rat_say "nothing due right now"
}

cmd_status() {
  if [ "${1:-}" = "--json" ]; then
    rat_py - "$RAT_CHECKPOINT" "$RAT_BUDGET" "$(rat_today)" "$RAT_HALT" <<'PY'
import json, os, sys
checkpoint, budget, day, halt = sys.argv[1:5]


def read(path):
    try:
        with open(path) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return {}


spent = float(read(budget).get("days", {}).get(day, 0.0))
state = {
    "halted": os.path.exists(halt),
    "halt_reason": open(halt).read().strip() if os.path.exists(halt) else None,
    "spent_today_usd": round(spent, 4),
    "loops": read(checkpoint).get("loops", {}),
}
print(json.dumps(state, indent=2))
PY
    return 0
  fi

  if rat_halted; then
    rat_err "HALTED - $(head -n 1 "$RAT_HALT")"
    echo "  clear it with: loop resume"
    echo
  fi
  local spent cap
  spent="$(rat_budget_today)"
  cap="$(rat_setting caps.max_usd_per_day 5.00)"
  printf 'today  $%s spent of $%s cap\n' "$spent" "$(printf '%.2f' "$cap")"
  printf 'shifts %s receipts kept, %s day(s) on disk\n' \
    "$(find "$RAT_STATE_DIR/receipts" -name receipt.json 2>/dev/null | wc -l | tr -d ' ')" \
    "$(find "$RAT_STATE_DIR/receipts" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')"
  echo
  printf '%-16s %-14s %-20s %s\n' LOOP LAST_VERDICT LAST_RUN RECEIPT
  rat_py - "$RAT_CHECKPOINT" <<'PY'
import json, os, signal, sys, time
signal.signal(signal.SIGPIPE, signal.SIG_DFL)   # `rat status | head` is fine
path = sys.argv[1]
if not os.path.exists(path):
    print("(no shift has run yet)")
    raise SystemExit(0)
with open(path) as fh:
    loops = json.load(fh).get("loops", {})
for name, entry in sorted(loops.items()):
    when = entry.get("last_started_epoch")
    when = time.strftime("%Y-%m-%d %H:%M", time.localtime(when)) if when else "-"
    print("%-16s %-14s %-20s %s" % (
        name, entry.get("last_verdict", "-"), when, entry.get("last_receipt", "-")))
PY
}

cmd_receipts() {
  local limit="10"
  local passthrough=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --loop|--verdict|--since) passthrough="$passthrough $1 $2"; shift 2 ;;
      --json) passthrough="$passthrough --json"; shift ;;
      -*) rat_err "receipts: unknown flag $1"; return 2 ;;
      *) limit="$1"; shift ;;
    esac
  done
  # shellcheck disable=SC2086
  rat_py "$RAT_ROOT/bin/lib/list_receipts.py" "$RAT_STATE_DIR/receipts" \
    --limit "$limit" $passthrough
}

cmd_show() {
  local dir=""
  local diff_first=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --diff) diff_first=1; shift ;;
      -*) rat_err "show: unknown flag $1"; return 2 ;;
      *) dir="$1"; shift ;;
    esac
  done
  if [ -z "$dir" ]; then
    local newest
    newest="$(find "$RAT_STATE_DIR/receipts" -name receipt.json 2>/dev/null | sort | tail -n 1)"
    if [ -z "$newest" ]; then
      rat_err "no receipts yet - try: bin/shift digest --dry-run"
      return 1
    fi
    dir="$(dirname "$newest")"
  fi
  [ -d "$dir" ] || dir="$RAT_ROOT/$dir"
  [ -d "$dir" ] && [ -f "$dir/receipt.json" ] || { rat_err "no receipt at: $dir"; return 1; }

  if [ "$diff_first" = "1" ]; then
    if [ -s "$dir/diff.patch" ]; then
      rat_say "-- what it changed"
      cat "$dir/diff.patch"
      echo
      rat_say "apply it with: bin/rat apply ${dir#"$RAT_ROOT"/}"
      echo
    else
      rat_say "that shift changed nothing - here is what it said instead"
      echo
    fi
  fi

  rat_say "== $dir"
  echo; cat "$dir/receipt.json"
  echo; rat_say "-- what it reported"; head -n 60 "$dir/output.md" 2>/dev/null
  if [ -s "$dir/grade.json" ]; then echo; rat_say "-- how it was graded"; cat "$dir/grade.json"; fi
  if [ -s "$dir/guard.json" ]; then echo; rat_say "-- what the guard saw"; head -n 30 "$dir/guard.json"; fi
}

# Watching a shift is not the same as reading its receipt afterwards. The receipt
# tells you what happened; the watch tells you where a shift is spending its
# night, which is the only way to find out that a loop is slow rather than stuck.
cmd_watch() {
  local want=""
  local timeout=300
  while [ $# -gt 0 ]; do
    case "$1" in
      --timeout) timeout="$2"; shift 2 ;;
      -*) rat_err "watch: unknown flag $1"; return 2 ;;
      *) want="$1"; shift ;;
    esac
  done

  mkdir -p "$RAT_STATE_DIR"
  touch "$RAT_TRACE"
  local seen
  seen="$(wc -l < "$RAT_TRACE" | tr -d ' ')"

  if [ -n "$(ls -d "$RAT_STATE_DIR"/locks/*.lock 2>/dev/null | head -n 1)" ]; then
    rat_say "attached to a shift already running"
  else
    rat_say "waiting for a shift to start (up to ${timeout}s) - ctrl-c to stop"
  fi

  local waited=0
  local started=""
  local chunk
  chunk="$(mktemp)"

  while [ "$waited" -lt "$timeout" ]; do
    local total
    total="$(wc -l < "$RAT_TRACE" | tr -d ' ')"
    if [ "$total" -gt "$seen" ]; then
      sed -n "$((seen + 1)),${total}p" "$RAT_TRACE" > "$chunk"
      seen="$total"
      while read -r line; do
        local loop phase status shift_id rest
        loop="$(printf '%s' "$line" | sed -n 's/.*loop=\([^ ]*\).*/\1/p')"
        phase="$(printf '%s' "$line" | sed -n 's/.*phase=\([^ ]*\).*/\1/p')"
        status="$(printf '%s' "$line" | sed -n 's/.*status=\([^ ]*\).*/\1/p')"
        shift_id="$(printf '%s' "$line" | sed -n 's/.*shift=\([^ ]*\).*/\1/p')"
        rest="$(printf '%s' "$line" | sed 's/.*status=[^ ]* *//')"
        [ -n "$want" ] && [ "$loop" != "$want" ] && continue
        [ -n "$started" ] || started="$loop/$shift_id"
        printf '%s  %-14s %-9s %-9s %s\n' \
          "$(printf '%s' "$line" | cut -c12-19)" "$loop" "$phase" "$status" "$rest"
        if [ "$phase" = "receipt" ]; then
          local dir
          dir="$(printf '%s' "$rest" | sed -n 's/.*dir=\([^ ]*\).*/\1/p')"
          echo
          if [ -n "$dir" ] && [ -f "$RAT_ROOT/$dir/output.md" ]; then
            rat_say "-- what it reported"
            head -n 12 "$RAT_ROOT/$dir/output.md"
            echo
            rat_say "full receipt: bin/rat show $dir"
          fi
          rm -f "$chunk"
          return 0
        fi
      done < "$chunk"
    fi
    sleep 1
    waited=$((waited + 1))
  done

  rm -f "$chunk"
  if [ -z "$started" ]; then
    rat_warn "nothing started within ${timeout}s"
    return 75
  fi
  rat_warn "gave up watching after ${timeout}s - the shift is still running"
  return 75
}

# trace.log is append-only and never rotated by a shift, on purpose: a loop that
# trims its own log is a loop you cannot audit. Pruning is the moment a person is
# already deciding what history to keep, so it happens here.
rotate_trace() {
  local max_lines=20000
  [ -f "$RAT_TRACE" ] || return 0
  local lines
  lines="$(wc -l < "$RAT_TRACE" | tr -d ' ')"
  [ "$lines" -le "$max_lines" ] && return 0
  if [ "${1:-}" = "--apply" ]; then
    tail -n "$max_lines" "$RAT_TRACE" > "$RAT_TRACE.new"
    mv "$RAT_TRACE" "$RAT_TRACE.1"
    mv "$RAT_TRACE.new" "$RAT_TRACE"
    printf 'rotated trace.log (%s lines, kept the last %s, older lines in trace.log.1)\n' \
      "$lines" "$max_lines"
  else
    printf 'would rotate trace.log (%s lines, over the %s line mark)\n' \
      "$lines" "$max_lines"
  fi
}

# The last step of the night shift is a human one. A shift that ran in a worktree
# leaves a patch and nothing else; this is how that patch reaches your tree, once
# you have read it and decided.
cmd_apply() {
  local dir="${1:-}"
  local check=0
  [ "${2:-}" = "--check" ] && check=1
  [ "${1:-}" = "--check" ] && { check=1; dir="${2:-}"; }

  if [ -z "$dir" ]; then
    dir="$(dirname "$(find "$RAT_STATE_DIR/receipts" -name diff.patch 2>/dev/null | sort | tail -n 1)")"
    [ -d "$dir" ] || { rat_err "no receipt with a patch in it yet"; return 1; }
    rat_say "the most recent patch: ${dir#"$RAT_ROOT"/}"
  fi
  [ -d "$dir" ] || dir="$RAT_ROOT/$dir"
  local patch="$dir/diff.patch"
  [ -s "$patch" ] || { rat_err "no patch in $dir - that shift changed nothing"; return 1; }

  local verdict
  verdict="$(rat_json_field "$dir/receipt.json" verdict unknown)"
  local files
  files="$(rat_json_field "$dir/guard.json" checked 0)"
  printf 'verdict %s, %s file(s), %s line(s) of diff\n' \
    "$verdict" "$files" "$(grep -c '^[+-]' "$patch" 2>/dev/null || echo 0)"

  if [ "$verdict" = "blocked" ]; then
    rat_warn "this shift was blocked by the guard - read guard.json before applying"
  fi

  if ! git -C "$RAT_ROOT" apply --check "$patch" 2>/dev/null; then
    rat_err "the patch no longer applies cleanly - the tree has moved since that shift"
    echo "  read it with: git apply --3way $patch"
    return 1
  fi

  if [ "$check" = "1" ]; then
    rat_say "it applies cleanly. run without --check to actually apply it"
    return 0
  fi

  git -C "$RAT_ROOT" apply "$patch"
  rat_trace apply ok "from=${dir#"$RAT_ROOT"/}"
  rat_say "applied. nothing was committed - the diff is in your working tree"
  echo "  undo with: git checkout -- ."
}

cmd_prune() {
  local keep keep_failed
  keep="$(rat_setting receipts.keep_days 30)"
  keep_failed="$(rat_setting receipts.keep_failed_days 90)"
  printf 'keeping passes for %s days, everything else for %s\n\n' "$keep" "$keep_failed"
  rat_py "$RAT_ROOT/bin/lib/prune.py" "$RAT_STATE_DIR/receipts" "$keep" "$keep_failed" "$@"
  rotate_trace "${1:-}"
}

# A pack is a directory with a plan and an act script. That is the whole
# distribution mechanism, and it is deliberately not a registry: installing a
# loop should be as reviewable as copying a folder, because that is what it is.
cmd_add() {
  local packs_dir="$RAT_ROOT/packs"

  if [ "${1:-}" = "--list" ] || [ $# -eq 0 ]; then
    if [ ! -d "$packs_dir" ]; then
      rat_err "no packs/ directory here - pass a path instead: bin/rat add ../some/loop"
      return 1
    fi
    printf '%-18s %s\n' PACK "WHAT IT DOES"
    local dir
    for dir in "$packs_dir"/*/; do
      [ -f "$dir/plan.md" ] || continue
      local name summary
      name="$(basename "$dir")"
      summary="$(rat_py "$RAT_CONF" body "$dir/plan.md" 2>/dev/null \
                 | grep -v '^#' | grep -v '^$' | head -n 1 | cut -c1-58)"
      printf '%-18s %s\n' "$name" "$summary"
    done
    echo
    echo "install one with: bin/rat add <name>"
    return 0
  fi

  local source="$1"
  [ -d "$source" ] || source="$packs_dir/$1"
  [ -d "$source" ] || { rat_err "no pack or directory called '$1'"; return 1; }
  [ -f "$source/plan.md" ] || { rat_err "$source has no plan.md, so it is not a loop"; return 1; }
  [ -f "$source/act.sh" ] || { rat_err "$source has no act.sh, so it is not a loop"; return 1; }

  local name
  name="$(basename "$source")"
  local dest="$RAT_LOOPS_DIR/$name"
  if [ -d "$dest" ]; then
    rat_err "$name is already installed - remove $dest first if you mean to replace it"
    return 1
  fi

  cp -R "$source" "$dest"
  chmod +x "$dest"/*.sh 2>/dev/null || true
  rat_say "installed $name from ${source#"$RAT_ROOT"/}"

  local autonomy
  autonomy="$(rat_py "$RAT_CONF" fm-get "$dest/plan.md" autonomy 2>/dev/null || echo report-only)"
  echo
  rat_py "$RAT_ROOT/bin/lib/validate.py" 2>&1 | grep -E "$name|FAIL" || true
  echo
  echo "it is not scheduled, and will not run until you say so:"
  echo
  echo "  1. read it:      \$EDITOR $dest/plan.md"
  echo "  2. try it:       bin/shift $name --dry-run"
  echo "  3. schedule it, by adding to .claude/loops/schedule.yml:"
  echo
  echo "       - name: $name"
  echo "         every: 1d"
  echo "         days: mon-fri"
  echo "         enabled: true"
  echo
  echo "installed at autonomy '$autonomy'. leave it there for a week."
}

cmd_new() {
  local name="${1:-}"
  [ -n "$name" ] || { rat_err "usage: loop new <name>"; return 2; }
  local dir="$RAT_LOOPS_DIR/$name"
  [ -d "$dir" ] && { rat_err "$name already exists"; return 1; }
  mkdir -p "$dir"
  sed "s/__NAME__/$name/g" "$RAT_LOOPS_DIR/_template/plan.md" > "$dir/plan.md"
  sed "s/__NAME__/$name/g" "$RAT_LOOPS_DIR/_template/act.sh"  > "$dir/act.sh"
  chmod +x "$dir/act.sh"
  rat_say "created $dir"
  echo "next: edit plan.md, then add it to .claude/loops/schedule.yml"
  echo "test it without a model:  bin/shift $name --dry-run"
}

cmd_doctor() {
  local problems=0
  check() {
    if eval "$2" >/dev/null 2>&1; then
      printf '  ok    %s\n' "$1"
    else
      printf '  FAIL  %s\n' "$1"; problems=$((problems + 1))
    fi
  }

  rat_say "the machine"
  check "python3 on PATH"                 "command -v python3"
  check "git on PATH"                     "command -v git"
  check "state/ is writable"              "touch '$RAT_STATE_DIR/.probe' && rm -f '$RAT_STATE_DIR/.probe'"
  check "kill.sh is executable"           "test -x '$RAT_ROOT/kill.sh'"
  check "local overrides stay untracked"  "git -C '$RAT_ROOT' check-ignore -q contract.local.md || ! git -C '$RAT_ROOT' rev-parse --git-dir"

  local agent
  agent="$(rat_setting agent.command claude)"
  if command -v "$agent" >/dev/null 2>&1; then
    printf '  ok    %s found at %s\n' "$agent" "$(command -v "$agent")"
  else
    printf '  warn  %s not on PATH - every shift will run as a dry run\n' "$agent"
  fi

  if rat_halted; then
    printf '  warn  state/HALT is present - nothing scheduled will start\n'
  fi

  echo
  rat_say "the configuration"
  local config_rc=0
  rat_py "$RAT_ROOT/bin/lib/validate.py" || config_rc=$?

  if [ "$problems" -eq 0 ] && [ "$config_rc" -eq 0 ]; then
    echo
    rat_say "nothing blocking. try: bin/shift digest --dry-run"
    return 0
  fi
  echo
  rat_err "$problems machine problem(s); the configuration report is above"
  return 1
}

cmd_resume() {
  [ -f "$RAT_HALT" ] || { rat_say "not halted"; return 0; }
  rm -f "$RAT_HALT"
  rat_trace resume ok "by=${USER:-unknown}"
  rat_say "halt cleared - the next scheduled shift will run"
}

case "${1:-}" in
  list)      shift; cmd_list "$@" ;;
  run)       shift; "$RAT_ROOT/bin/shift" "$@" ;;
  run-due)   shift; cmd_run_due "$@" ;;
  status)    shift; cmd_status "$@" ;;
  receipts)  shift; cmd_receipts "$@" ;;
  show)      shift; cmd_show "$@" ;;
  trace)     shift; tail -n "${1:-20}" "$RAT_TRACE" 2>/dev/null || rat_say "no trace yet" ;;
  new)       shift; cmd_new "$@" ;;
  add)       shift; cmd_add "$@" ;;
  prune)     shift; cmd_prune "$@" ;;
  watch)     shift; cmd_watch "$@" ;;
  replay)    shift; "$RAT_ROOT/bin/replay" "$@" ;;
  apply)     shift; cmd_apply "$@" ;;
  cron)      shift; rat_py "$SCHED_PY" cron "$SCHEDULE" "$RAT_ROOT" ;;
  audit)     shift; rat_py "$RAT_ROOT/bin/lib/audit.py" "$RAT_STATE_DIR" "$@" ;;
  doctor)    shift; cmd_doctor "$@" ;;
  resume)    shift; cmd_resume "$@" ;;
  -v|--version|version) printf 'loop rat %s\n' "$RAT_VERSION" ;;
  ""|-h|--help|help) usage ;;
  *)         rat_err "unknown command: $1"; echo; usage; exit 2 ;;
esac
