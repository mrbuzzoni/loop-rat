#!/usr/bin/env bash
# shift - run one shift of one loop, end to end.
#
#   bin/shift pr-hunter [--dry-run] [--prompt-only]
#
# Phases: preflight -> act -> verify -> guard -> grade -> receipt.
# Every phase appends to state/trace.log. The shift leaves behind one receipt
# folder whether it succeeded, failed, or was stopped.
#
# Exit codes: 0 pass  2 needs review  3 blocked by guard  4 verify failed
#             75 skipped (halted, locked, or out of budget)  1 harness error
#             130 interrupted by hand or by kill.sh - a receipt is still written
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
. "$HERE/lib/common.sh"

PROMPT_ONLY=0
RAT_LOOP=""
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run)     export RAT_DRY_RUN=1; shift ;;
    --prompt-only) PROMPT_ONLY=1; shift ;;
    -h|--help)     awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "$0"; exit 0 ;;
    -*)            rat_err "shift: unknown flag $1"; exit 2 ;;
    *)             RAT_LOOP="$1"; shift ;;
  esac
done

[ -n "$RAT_LOOP" ] || { rat_err "usage: bin/shift <loop-name> [--dry-run]"; exit 2; }
export RAT_LOOP

LOOP_DIR="$RAT_LOOPS_DIR/$RAT_LOOP"
PLAN="$LOOP_DIR/plan.md"
ACT="$LOOP_DIR/act.sh"
[ -f "$RAT_ROOT/CONTRACT.md" ] || {
  rat_err "no CONTRACT.md at $RAT_ROOT - a shift without rules is not a shift"
  exit 1
}
[ -f "$PLAN" ] || { rat_err "no plan for '$RAT_LOOP' (expected $PLAN)"; exit 1; }
[ -x "$ACT" ]  || { rat_err "no executable act.sh for '$RAT_LOOP' (expected $ACT)"; exit 1; }

# ---------------------------------------------------------------- preflight --
if rat_halted; then
  rat_warn "halted: $(head -n 1 "$RAT_HALT" 2>/dev/null)"
  rat_trace preflight skipped "reason=halt"
  exit 75
fi

TIMEOUT="$(rat_py "$RAT_CONF" fm-get "$PLAN" timeout 2>/dev/null || true)"
[ -n "$TIMEOUT" ] || TIMEOUT="$(rat_setting caps.timeout_seconds 900)"
MAX_USD="$(rat_py "$RAT_CONF" fm-get "$PLAN" max_usd 2>/dev/null || true)"
[ -n "$MAX_USD" ] || MAX_USD="$(rat_setting caps.max_usd_per_shift 1.00)"
DAY_CAP="$(rat_setting caps.max_usd_per_day 5.00)"
RUBRICS="$(rat_py "$RAT_CONF" fm-get "$PLAN" rubrics 2>/dev/null | tr -d '[]"' | tr ',' ' ' || true)"
AUTONOMY="$(rat_py "$RAT_CONF" fm-get "$PLAN" autonomy 2>/dev/null || true)"
[ -n "$AUTONOMY" ] || AUTONOMY="report-only"
export RAT_AUTONOMY="$AUTONOMY"
VERIFY_CMD="$(rat_py "$RAT_CONF" fm-get "$PLAN" verify 2>/dev/null || true)"
USE_WORKTREE="$(rat_py "$RAT_CONF" fm-get "$PLAN" worktree 2>/dev/null || true)"
REPAIR_LIMIT="$(rat_py "$RAT_CONF" fm-get "$PLAN" repair 2>/dev/null || true)"
[ -n "$REPAIR_LIMIT" ] || REPAIR_LIMIT=0
# Two is the ceiling whatever a plan asks for. A third attempt at the same
# failure is not persistence, it is a loop that has stopped learning.
[ "$REPAIR_LIMIT" -gt 2 ] 2>/dev/null && REPAIR_LIMIT=2

SPENT_TODAY="$(rat_budget_today)"
if rat_py -c "import sys; sys.exit(0 if float(sys.argv[1]) >= float(sys.argv[2]) else 1)" "$SPENT_TODAY" "$DAY_CAP"; then
  rat_warn "daily budget spent ($SPENT_TODAY of $DAY_CAP) - not starting a shift"
  rat_trace preflight skipped "reason=budget spent=$SPENT_TODAY cap=$DAY_CAP"
  exit 75
fi

if ! rat_lock "$RAT_LOOP" "$((TIMEOUT + 120))"; then
  rat_warn "a $RAT_LOOP shift is already running - skipping this one"
  rat_trace preflight skipped "reason=locked"
  exit 75
fi
trap 'rat_unlock "$RAT_LOOP"' EXIT

RAT_CHILD_PID=""

# A shift that is stopped is still a shift that happened. Ctrl-C and kill.sh both
# land here, and both leave a receipt saying where the night was cut off - an
# interrupted shift with no paperwork is the one you cannot reason about later.
on_interrupt() {
  local signal="$1"
  trap - INT TERM
  [ -n "$RAT_CHILD_PID" ] && kill -TERM "$RAT_CHILD_PID" 2>/dev/null
  rat_trace "${PHASE:-act}" interrupted "signal=$signal"

  if [ -n "${RAT_RECEIPT:-}" ] && [ -d "${RAT_RECEIPT:-}" ]; then
    RAT_ACT_STATUS="interrupted" RAT_ACT_RC="130" \
    RAT_ACT_SECONDS="$(( $(rat_epoch) - ${ACT_START:-$(rat_epoch)} ))" \
    RAT_VERIFY_STATUS="skipped" RAT_VERIFY_CMD="${VERIFY_CMD:-}" \
    RAT_GUARD_STATUS="not-run" RAT_CHANGED="0" \
    RAT_VERDICT="interrupted" RAT_AUTONOMY="${AUTONOMY:-report-only}" \
    RAT_COST="$(rat_py "$RAT_ROOT/bin/lib/sum_cost.py" "$RAT_RECEIPT" 2>/dev/null || echo 0)" \
    RAT_STARTED="${STARTED_ISO:-$(rat_now_iso)}" RAT_ENDED="$(rat_now_iso)" \
    RAT_DURATION="$(( $(rat_epoch) - ${STARTED_EPOCH:-$(rat_epoch)} ))" \
    rat_py "$RAT_ROOT/bin/lib/write_receipt.py" 2>/dev/null || true
    printf '\n**The shift was interrupted (%s).**\n\nWhatever it had written by then is in this folder.\n' \
      "$signal" >> "$RAT_RECEIPT/output.md"
  fi

  rat_unlock "$RAT_LOOP"
  rat_warn "$RAT_LOOP interrupted - receipt kept at ${RAT_RECEIPT#"$RAT_ROOT"/}"
  exit 130
}
trap 'on_interrupt INT' INT
trap 'on_interrupt TERM' TERM

RAT_SHIFT_ID="$(date +%H%M%S)"
export RAT_SHIFT_ID
RAT_RECEIPT="$RAT_STATE_DIR/receipts/$(rat_today)/$RAT_SHIFT_ID-$RAT_LOOP"
export RAT_RECEIPT
mkdir -p "$RAT_RECEIPT"
STARTED_EPOCH="$(rat_epoch)"
STARTED_ISO="$(rat_now_iso)"

rat_trace preflight ok "autonomy=$AUTONOMY timeout=${TIMEOUT}s cap=\$$MAX_USD dry=${RAT_DRY_RUN:-0}"

# ------------------------------------------------------------------ prompt --
{
  echo "# Shift brief: $RAT_LOOP"
  echo
  echo "Shift id: $RAT_SHIFT_ID   started: $STARTED_ISO"
  echo "Receipt folder: $RAT_RECEIPT"
  echo
  echo "## Your autonomy this shift: $AUTONOMY"
  echo
  case "$AUTONOMY" in
    report-only)
      echo "You may read anything and write only inside your receipt folder."
      echo "Changing a file in the repository ends the shift as blocked, even if"
      echo "the change would have been correct. Report what you would have done."
      ;;
    assisted)
      echo "You may change files the plan puts in scope, within the blast radius."
      echo "A human reads the diff before it goes anywhere."
      ;;
    autonomous)
      echo "You may change files and rerun the verify command yourself."
      echo "Nothing you do leaves this machine, and nothing merges on its own."
      ;;
  esac
  echo
  echo "## The contract"
  echo
  cat "$RAT_ROOT/CONTRACT.md"
  if [ -f "$RAT_ROOT/contract.local.md" ]; then
    echo
    echo "## Local overrides (these win over the contract above)"
    echo
    cat "$RAT_ROOT/contract.local.md"
  fi
  for rubric in $RUBRICS; do
    if [ -f "$RAT_LOOPS_DIR/rubrics/$rubric.md" ]; then
      echo
      echo "## You will be graded against rubrics/$rubric.md"
      echo
      cat "$RAT_LOOPS_DIR/rubrics/$rubric.md"
    fi
  done
  if [ -f "$RAT_CHECKPOINT" ]; then
    echo
    echo "## Where the last shift stopped"
    echo
    echo '```json'
    rat_py "$RAT_CONF" get "$RAT_CHECKPOINT" "loops.$RAT_LOOP" 2>/dev/null || echo '{}'
    echo '```'
  fi
  echo
  echo "## The job"
  echo
  rat_py "$RAT_CONF" body "$PLAN"
} > "$RAT_RECEIPT/prompt.md"

if [ "$PROMPT_ONLY" = "1" ]; then
  cat "$RAT_RECEIPT/prompt.md"
  exit 0
fi

# --------------------------------------------------------------------- act --
# Where the shift works. Normally the repository itself; with `worktree: true`
# a throwaway checkout, so a night that goes wrong leaves your tree untouched and
# arrives in the morning as a patch instead of as a surprise.
WORKDIR="$RAT_ROOT"
WORKTREE_PATH=""
if [ "$USE_WORKTREE" = "1" ] || [ "$USE_WORKTREE" = "true" ]; then
  if git -C "$RAT_ROOT" rev-parse HEAD >/dev/null 2>&1; then
    WORKTREE_PATH="$RAT_STATE_DIR/worktrees/$RAT_LOOP-$RAT_SHIFT_ID"
    mkdir -p "$(dirname "$WORKTREE_PATH")"
    # No --quiet: it is newer than the git that ships with some macOS setups,
    # and a harness that only runs on a fresh toolchain is not a harness.
    if git -C "$RAT_ROOT" worktree add --detach "$WORKTREE_PATH" HEAD \
         >>"$RAT_RECEIPT/stderr.log" 2>&1; then
      WORKDIR="$WORKTREE_PATH"
      rat_trace worktree ok "at=${WORKTREE_PATH#"$RAT_ROOT"/}"
    else
      WORKTREE_PATH=""
      rat_warn "could not create a worktree - running in the repository instead"
      rat_trace worktree failed "falling back to the repository"
    fi
  else
    rat_warn "no commit to branch from - running in the repository instead"
    rat_trace worktree skipped "no HEAD"
  fi
fi
export RAT_WORKDIR="$WORKDIR"

export RAT_PLAN="$PLAN"
export RAT_TIMEOUT="$TIMEOUT"
# So a retry can tell whether it has time to finish rather than being killed
# halfway through a wait it should never have started.
export RAT_SHIFT_DEADLINE="$(( $(rat_epoch) + TIMEOUT ))"
export RAT_MAX_USD="$MAX_USD"
export PATH="$RAT_ROOT/bin:$PATH"

RAT_WORKDIR="$WORKDIR" rat_py "$RAT_ROOT/bin/lib/guard.py" --snapshot "$RAT_RECEIPT/tree-before.txt" || true

PHASE="act"
ACT_START="$(rat_epoch)"
( cd "$WORKDIR" && rat_run_timeout "$TIMEOUT" "$ACT" ) \
  > "$RAT_RECEIPT/output.md" 2>> "$RAT_RECEIPT/stderr.log"
ACT_RC=$?
ACT_SECONDS=$(( $(rat_epoch) - ACT_START ))

if [ "$ACT_RC" -eq 143 ] || [ "$ACT_RC" -eq 137 ]; then
  rat_trace act timeout "after=${ACT_SECONDS}s"
  ACT_STATUS="timeout"
elif [ "$ACT_RC" -ne 0 ]; then
  rat_trace act error "rc=$ACT_RC after=${ACT_SECONDS}s"
  ACT_STATUS="error"
else
  rat_trace act ok "after=${ACT_SECONDS}s"
  ACT_STATUS="ok"
fi

# ------------------------------------------------------------------ verify --
PHASE="verify"
VERIFY_STATUS="skipped"
ATTEMPTS=1

run_verify() {
  ( cd "$WORKDIR" && rat_run_timeout "$TIMEOUT" bash -c "$VERIFY_CMD" ) \
    > "$RAT_RECEIPT/verify-$1.log" 2>&1
}

if [ -n "$VERIFY_CMD" ] && [ "$ACT_STATUS" = "ok" ]; then
  if run_verify "$ATTEMPTS"; then
    VERIFY_STATUS="pass"
  else
    VERIFY_STATUS="fail"
  fi
  rat_trace verify "$VERIFY_STATUS" "attempt=$ATTEMPTS cmd=$(printf '%s' "$VERIFY_CMD" | cut -c1-40)"

  # One repair, then stop. The loop gets to see exactly what failed and what it
  # already changed - and if the second answer fails the same way, that is a
  # finding for a person, not a reason to try a third time.
  while [ "$VERIFY_STATUS" = "fail" ] && [ "$ATTEMPTS" -le "$REPAIR_LIMIT" ]; do
    PHASE="repair"
    ATTEMPTS=$((ATTEMPTS + 1))
    {
      echo "# Repair attempt $ATTEMPTS of $((REPAIR_LIMIT + 1))"
      echo
      echo "Your change did not pass the check. You are being given one more"
      echo "attempt, and only one. If the same failure survives it, stop and"
      echo "describe what you now know instead of trying something else."
      echo
      cat "$RAT_RECEIPT/prompt.md"
      echo
      echo "## What you reported the first time"
      echo
      head -c 8000 "$RAT_RECEIPT/output.md"
      echo
      echo "## What you have changed so far"
      echo
      echo '```diff'
      ( cd "$WORKDIR" && git diff 2>/dev/null | head -c 12000 )
      echo '```'
      echo
      echo "## What the check said"
      echo
      echo '```'
      tail -c 8000 "$RAT_RECEIPT/verify-$((ATTEMPTS - 1)).log"
      echo '```'
      echo
      echo "Command: \`$VERIFY_CMD\`. Fix the cause, then say what you changed."
    } | ( cd "$WORKDIR" && "$RAT_ROOT/bin/rat-agent" --tag "repair-$ATTEMPTS" ) \
      >> "$RAT_RECEIPT/output.md" 2>>"$RAT_RECEIPT/stderr.log"

    if run_verify "$ATTEMPTS"; then
      VERIFY_STATUS="pass"
    else
      VERIFY_STATUS="fail"
    fi
    rat_trace repair "$VERIFY_STATUS" "attempt=$ATTEMPTS of $((REPAIR_LIMIT + 1))"
  done
fi

# ------------------------------------------------------------------- guard --
PHASE="guard"
GUARD_STATUS="ok"
if RAT_WORKDIR="$WORKDIR" rat_py "$RAT_ROOT/bin/lib/guard.py" "$RAT_SETTINGS" "$RAT_RECEIPT/tree-before.txt" "$AUTONOMY" > "$RAT_RECEIPT/guard.json" 2>>"$RAT_RECEIPT/stderr.log"; then
  rat_trace guard ok ""
else
  GUARD_STATUS="blocked"
  rat_trace guard blocked "autonomy=$AUTONOMY see guard.json"
fi
CHANGED="$(rat_json_field "$RAT_RECEIPT/guard.json" checked 0)"
if [ "${CHANGED:-0}" != "0" ] && git -C "$WORKDIR" rev-parse --git-dir >/dev/null 2>&1; then
  # A private index, so the patch includes new files without staging or
  # unstaging anything in the index you were actually using.
  SCRATCH_INDEX="$RAT_RECEIPT/.index"
  cp "$(git -C "$WORKDIR" rev-parse --git-path index)" "$SCRATCH_INDEX" 2>/dev/null || : > "$SCRATCH_INDEX"
  # Only what the guard saw this shift change - not work you left on the
  # branch, and not files that were already dirty when the night began.
  rat_py - "$RAT_RECEIPT/guard.json" <<'PY' > "$RAT_RECEIPT/.touched"
import json, sys
try:
    for path in json.load(open(sys.argv[1])).get("files", []):
        print(path)
except (OSError, ValueError):
    pass
PY
  if [ -s "$RAT_RECEIPT/.touched" ]; then
    GIT_INDEX_FILE="$SCRATCH_INDEX" git -C "$WORKDIR" reset -q HEAD -- . 2>/dev/null || true
    while IFS= read -r touched; do
      GIT_INDEX_FILE="$SCRATCH_INDEX" git -C "$WORKDIR" add -- "$touched" 2>/dev/null || true
    done < "$RAT_RECEIPT/.touched"
    GIT_INDEX_FILE="$SCRATCH_INDEX" git -C "$WORKDIR" diff --cached HEAD -- \
      > "$RAT_RECEIPT/diff.patch" 2>/dev/null || true
  fi
  rm -f "$SCRATCH_INDEX" "$RAT_RECEIPT/.touched"
fi

# ------------------------------------------------------------------- grade --
if [ -n "$WORKTREE_PATH" ]; then
  if [ "${RAT_KEEP_WORKTREE:-0}" = "1" ]; then
    rat_trace worktree kept "at=${WORKTREE_PATH#"$RAT_ROOT"/}"
  else
    # `worktree remove` arrived in git 2.17; older versions still understand a
    # deleted directory plus a prune, so do that when the subcommand is missing.
    if ! git -C "$RAT_ROOT" worktree remove --force "$WORKTREE_PATH" \
           >>"$RAT_RECEIPT/stderr.log" 2>&1; then
      rm -rf "$WORKTREE_PATH"
      git -C "$RAT_ROOT" worktree prune >>"$RAT_RECEIPT/stderr.log" 2>&1 || true
    fi
    rat_trace worktree removed "the patch is in the receipt"
  fi
fi

PHASE="grade"
GRADE_MODE="$(rat_setting grading.mode auto)"
if [ "$GUARD_STATUS" = "blocked" ]; then
  VERDICT="blocked"
elif [ "$ACT_STATUS" != "ok" ]; then
  VERDICT="fail"
elif [ "$VERIFY_STATUS" = "fail" ]; then
  VERDICT="fail"
elif [ -n "$RUBRICS" ] && [ "$GRADE_MODE" != "off" ]; then
  # The reading is done by bin/grade so that `rat calibrate` can repeat it later
  # against rubrics that have changed since, using the same code path.
  VERDICT="$("$RAT_ROOT/bin/grade" "$RAT_RECEIPT" \
    --plan "$PLAN" --rubrics "$RUBRICS" 2>>"$RAT_RECEIPT/stderr.log")"
  [ -n "$VERDICT" ] || VERDICT="needs-review"
  rat_trace grade "$VERDICT" \
    "score=$(rat_json_field "$RAT_RECEIPT/grade.json" score -) graders=$(rat_json_field "$RAT_RECEIPT/grade.json" graders 1)"
else
  VERDICT="pass"
fi

# ----------------------------------------------------------------- receipt --
ENDED_EPOCH="$(rat_epoch)"
COST="$(rat_py "$RAT_ROOT/bin/lib/sum_cost.py" "$RAT_RECEIPT")"

RAT_ACT_STATUS="$ACT_STATUS" RAT_ACT_RC="$ACT_RC" RAT_ACT_SECONDS="$ACT_SECONDS" \
RAT_VERIFY_STATUS="$VERIFY_STATUS" RAT_VERIFY_CMD="$VERIFY_CMD" \
RAT_GUARD_STATUS="$GUARD_STATUS" RAT_CHANGED="${CHANGED:-0}" \
RAT_AUTONOMY="$AUTONOMY" \
RAT_VERDICT="$VERDICT" RAT_COST="$COST" \
RAT_ATTEMPTS="$ATTEMPTS" RAT_WORKTREE="$([ -n "$WORKTREE_PATH" ] && echo 1 || echo 0)" \
RAT_STARTED="$STARTED_ISO" RAT_ENDED="$(rat_now_iso)" \
RAT_DURATION="$(( ENDED_EPOCH - STARTED_EPOCH ))" \
rat_py "$RAT_ROOT/bin/lib/write_receipt.py"

rat_with_lock checkpoint rat_py - "$RAT_CHECKPOINT" "$RAT_LOOP" "$RAT_RECEIPT" "$VERDICT" "$STARTED_EPOCH" "$RAT_RECEIPT/cursor.json" <<'PY'
import json, os, sys
path, loop, receipt, verdict, started, cursor_path = sys.argv[1:7]
data = {"loops": {}}
if os.path.exists(path):
    try:
        with open(path) as fh:
            data = json.load(fh)
    except ValueError:
        pass
data.setdefault("loops", {})
entry = data["loops"].setdefault(loop, {})
entry.update({
    "last_receipt": os.path.relpath(receipt, os.path.dirname(os.path.dirname(path))),
    "last_verdict": verdict,
    "last_started_epoch": int(started),
})
if os.path.exists(cursor_path):          # act.sh may leave a resume cursor
    try:
        with open(cursor_path) as fh:
            entry["cursor"] = json.load(fh)
    except ValueError:
        pass
with open(path, "w") as fh:
    json.dump(data, fh, indent=2)
    fh.write("\n")
PY

RECEIPT_HASH="$(rat_hash < "$RAT_RECEIPT/receipt.json")"
rat_trace receipt "$VERDICT" "cost=\$$COST dir=${RAT_RECEIPT#"$RAT_ROOT"/} rhash=$RECEIPT_HASH"

printf '%s %s  %s  %ss  $%s  %s\n' \
  "$(rat_color 1)$RAT_LOOP$(rat_color 0)" "$RAT_SHIFT_ID" "$VERDICT" \
  "$(( ENDED_EPOCH - STARTED_EPOCH ))" "$COST" "${RAT_RECEIPT#"$RAT_ROOT"/}"

case "$VERDICT" in
  pass)         exit 0 ;;
  blocked)      exit 3 ;;
  fail)         [ "$VERIFY_STATUS" = "fail" ] && exit 4; exit 2 ;;
  *)            exit 2 ;;
esac
