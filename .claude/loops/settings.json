{
  "version": 1,
  "agent": {
    "command": "claude",
    "args": ["-p", "--output-format", "json", "--permission-mode", "acceptEdits"],
    "result_field": "result",
    "cost_field": "total_cost_usd"
  },
  "autonomy": {
    "report-only": { "may_change_files": false, "max_files_changed": 0 },
    "assisted":    { "may_change_files": true,  "max_files_changed": 10 },
    "autonomous":  { "may_change_files": true,  "max_files_changed": 20 }
  },
  "caps": {
    "max_usd_per_shift": 1.00,
    "max_usd_per_day": 5.00,
    "timeout_seconds": 900,
    "max_files_changed": 10
  },
  "guard": {
    "scan_secrets": true,
    "path_policy": [
      { "pattern": "bin/**",             "min_level": "autonomous" },
      { "pattern": ".claude/loops/**",   "min_level": "autonomous" },
      { "pattern": "tests/**",           "min_level": "autonomous" },
      { "pattern": "CONTRACT.md",        "min_level": "autonomous" },
      { "pattern": "docs/**",            "min_level": "assisted" },
      { "pattern": "README.md",          "min_level": "assisted" }
    ],
    "denylist": [
      "**/.env",
      "**/.env.*",
      "**/secrets/**",
      "**/credentials/**",
      "**/*_key*",
      "**/*_secret*",
      "**/id_rsa*",
      "**/migrations/**",
      "**/auth/**",
      "**/billing/**",
      "**/payments/**",
      "**/.github/workflows/**",
      "**/terraform/**",
      "**/k8s/production/**",
      "package-lock.json",
      "yarn.lock",
      "pnpm-lock.yaml"
    ]
  },
  "grading": {
    "mode": "auto"
  },
  "receipts": {
    "keep_days": 30,
    "keep_failed_days": 90
  }
}
