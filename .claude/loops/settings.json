{
  "version": 1,
  "agent": {
    "command": "claude",
    "args": [
      "-p",
      "--output-format",
      "json",
      "--permission-mode",
      "acceptEdits"
    ],
    "result_field": "result",
    "cost_field": "total_cost_usd",
    "retries": 2,
    "retry_delay_seconds": 20,
    "model": ""
  },
  "autonomy": {
    "report-only": {
      "may_change_files": false,
      "max_files_changed": 0
    },
    "assisted": {
      "may_change_files": true,
      "max_files_changed": 10
    },
    "autonomous": {
      "may_change_files": true,
      "max_files_changed": 20
    }
  },
  "caps": {
    "max_usd_per_shift": 2.5,
    "max_usd_per_day": 12.0,
    "timeout_seconds": 1200,
    "max_files_changed": 10,
    "max_calls_per_day": 12,
    "pause_after_failures": 3
  },
  "guard": {
    "scan_secrets": true,
    "path_policy": [
      {
        "pattern": "bin/**",
        "min_level": "autonomous"
      },
      {
        "pattern": ".claude/loops/**",
        "min_level": "autonomous"
      },
      {
        "pattern": "tests/**",
        "min_level": "autonomous"
      },
      {
        "pattern": "CONTRACT.md",
        "min_level": "autonomous"
      },
      {
        "pattern": "docs/**",
        "min_level": "assisted"
      },
      {
        "pattern": "README.md",
        "min_level": "assisted"
      }
    ],
    "denylist": [
      "**/.env",
      "**/.env.*",
      "**/secrets/**",
      "**/credentials/**",
      "**/*_key*",
      "**/*_secret*",
      "**/id_rsa*",
      "**/migrations/**",
      "**/auth/**",
      "**/billing/**",
      "**/payments/**",
      "**/.github/workflows/**",
      "**/terraform/**",
      "**/k8s/production/**",
      "package-lock.json",
      "yarn.lock",
      "pnpm-lock.yaml"
    ],
    "ignore_paths": [
      "node_modules/**",
      "**/node_modules/**",
      "venv/**",
      ".venv/**",
      "**/__pycache__/**",
      "**/*.pyc",
      "target/**",
      "dist/**",
      "build/**",
      ".next/**",
      ".pytest_cache/**",
      ".mypy_cache/**",
      ".ruff_cache/**",
      "*.egg-info/**",
      ".gradle/**",
      "vendor/**"
    ]
  },
  "grading": {
    "mode": "auto",
    "graders": 1,
    "model": "haiku"
  },
  "receipts": {
    "keep_days": 30,
    "keep_failed_days": 90
  },
  "state": {
    "branch": "loop-rat-state"
  },
  "notify": {
    "//": "A command run when a shift ends with one of the verdicts in `on`. It gets RAT_VERDICT, RAT_NOTIFY_LOOP, RAT_NOTIFY_RECEIPT and RAT_NOTIFY_TEXT in the environment. Empty means silence.",
    "command": "",
    "on": "needs-review fail blocked interrupted"
  }
}
